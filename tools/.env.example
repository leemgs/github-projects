# Copy this file to `.env` (which is gitignored) and fill in your values.
# NEVER commit real tokens or passwords.

# GitHub Personal Access Token.
#   - Classic token: needs the "repo" scope.
#   - Fine-grained token: needs "Secrets" repository permission = Read and write.
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# The NEW value to write into the GMAIL_APP_PASSWORD secret in every repo.
# (You can also supply this via --value-file or the hidden interactive prompt.)
GMAIL_APP_PASSWORD_NEW=
